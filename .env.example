# Kripto Coin Analiz Uygulaması — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve API key'lerinizi girin.

# CryptoPanic API Key (Ücretsiz)
# https://cryptopanic.com/developers/api/ adresinden alın
CRYPTOPANIC_API_KEY=

# Reddit API (Opsiyonel)
# https://www.reddit.com/prefs/apps adresinden alın
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Telegram Bildirim Ayarları (Opsiyonel)
# Bot Token almak için Telegram'da @BotFather kullanın.
TELEGRAM_TOKEN=

# İşlem (Al/Sat/Kâr) bildirimlerinin gideceği Chat/Kanal ID'si
TELEGRAM_CHAT_ID=

# Sadece verilerin (JSON Cloud Sync) gideceği ayrı Chat/Kanal ID'si (Opsiyonel)
# Eğer boş bırakılırsa veriler TELEGRAM_CHAT_ID'ye gönderilir.
TELEGRAM_DATA_CHAT_ID=

# ─── Güvenlik / Security ────────────────────────────────────────────────────
# Panelden ayar kaydetme, işlem kapatma, Telegram testi/raporu ve DB sıfırlama
# için gereken yönetici anahtarı (X-Admin-Token başlığı ile gönderilir).
# Boş bırakılırsa bu uç noktalar 503 döner; okuma ekranları yine çalışır.
# Üretmek için: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Backend'e tarayıcıdan erişebilecek panel adresleri (virgülle ayrılmış).
# Örn: https://<panel-adresiniz>.vercel.app,http://localhost:8080
# Boş bırakılırsa CORS kapalıdır (yalnızca aynı origin).
CORS_ORIGINS=

# 1 yapılırsa arka plan bot motoru başlatılmaz, sadece API çalışır (test / çevrimdışı demo).
DISABLE_BOT_ENGINE=
